#include <stdio.h>
#include <string.h>

void reverseString(char str[]) {
    int len = strlen(str);

    printf("Reversed String = ");

    for(int i = len - 1; i >= 0; i--) {
        printf("%c", str[i]);
    }
}

int main() {
    char str[100];

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    str[strcspn(str, "\n")] = '\0';

    reverseString(str);

    return 0;
}
